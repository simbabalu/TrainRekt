{
  "Helius": {
    "RpcBaseUrl": "https://mainnet.helius-rpc.com"
  },
  "Gemini": {
    "Enabled": false,
    "Model": "gemini-2.5-flash-lite",
    "BaseUrl": "https://generativelanguage.googleapis.com",
    "TimeoutSeconds": 15,
    "MaxResearchOutputTokens": 1200,
    "MaxExtractionOutputTokens": 1800,
    "EnableGoogleSearch": true,
    "MaxResponseBytes": 524288
  },
  "AiSafetyCoach": {
    "Enabled": false,
    "Language": "en",
    "FreshnessHours": 24,
    "MaxOutputTokens": 700,
    "MaxSummaryLength": 360,
    "MaxListItemLength": 220,
    "MaxRiskExplanations": 4,
    "MaxWhatToCheckNext": 4,
    "MaxUncertaintyItems": 4,
    "MaxReviewSignals": 12,
    "MaxEvidencePerSignal": 6,
    "MaxClaimSummaries": 12,
    "MaxProtocolBreakdownItems": 12,
    "MaxSourcesPerClaim": 3
  },
  "TokenIdentityProvenance": {
    "MaxReturnedCollisions": 25
  },
  "MongoDb": {
    "Enabled": false,
    "DatabaseName": "trainrekt",
    "TokenCollectionName": "tokens",
    "TokenInspectionCollectionName": "tokenInspections",
    "TokenResearchCollectionName": "tokenResearch",
    "TokenInspectionCoachCollectionName": "tokenInspectionCoach",
    "TokenIdentityObservationCollectionName": "tokenIdentityObservations"
  },
  "TokenInspectionCache": {
    "FreshnessMinutes": 5
  },
  "TokenResearch": {
    "FreshnessHours": 24,
    "LargestUnknownTokenAccountThresholdPercent": 10,
    "MaxSources": 16,
    "MaxClaims": 32,
    "MaxStatementLength": 600,
    "MaxUrlLength": 2048,
    "MaxTitleLength": 160,
    "MaxPublisherLength": 120,
    "ProviderTimeoutSeconds": 8,
    "SourceTimeoutSeconds": 8,
    "MaxRedirects": 3,
    "MaxResponseBytes": 1048576,
    "AllowedHttpsPorts": [443],
    "AcceptCanonicalProjectWebsite": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
